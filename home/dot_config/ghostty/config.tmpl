# Ghostty config. Managed by chezmoi: source lives in
# home/dot_config/ghostty/config in the machine-setup repo.
# All options: `ghostty +show-config --default --docs`

# Follow the macOS light/dark setting.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha

# Nerd Font so starship's git/language glyphs render (installed via Brewfile).
font-family = JetBrainsMono Nerd Font
font-size = 14

window-padding-x = 8
window-padding-y = 6
macos-titlebar-style = tabs

# Already Ghostty's default; set explicitly because ~/.claude/cc-status relies
# on it to surface "Claude finished / needs you" alerts (OSC 9).
desktop-notifications = true

# Machine-only tweaks from the gitignored local/ folder in the repo (see the
# README's "Local, uncommitted tweaks" section). Must stay last: included
# files load after this one, so they override anything above. `?` = optional.
config-file = ?{{ .chezmoi.workingTree }}/local/ghostty.conf
