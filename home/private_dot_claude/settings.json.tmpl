{
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "gopls-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_NO_AUTO_UPDATE": "1"
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "repo": "thedotmack/claude-mem",
        "source": "github"
      }
    },
    "wabmalia": {
      "source": {
        "source": "git",
        "url": "git@github.com:wabmalia/sk1llz.git"
      }
    }
  },
  "hooks": {
    "Notification": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "PermissionRequest": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "PostToolUse": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "SessionEnd": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "SessionStart": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "Stop": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "StopFailure": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "SubagentStop": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "command": "sh {{ .chezmoi.homeDir }}/.claude/cc-status", "type": "command" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(git log:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(yarn test run)"
    ],
    "ask": [],
    "deny": [
      "Bash(curl:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Read(./env/*)"
    ]
  },
  "statusLine": {
    "command": "sh {{ .chezmoi.homeDir }}/.claude/statusline-command.sh",
    "type": "command"
  }
}
