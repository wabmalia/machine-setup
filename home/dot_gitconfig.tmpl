[user]
    name = {{ .name }}
    email = {{ .email }}

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[core]
    editor = nvim

[alias]
    st = status
    co = checkout
    br = branch
    lg = log --oneline --graph --decorate --all

# Per-host config, generated/owned entirely by gpg/setup-gpg-keys.sh (not
# chezmoi) — e.g. commit signing key. Routed by remote URL, not by company
# name, so this stays generic even if what's behind gitlab.com changes.
# See README.md "Company/client-specific config".
# `*/**` rather than `**`: in these URL globs `**` only spans slashes as a
# whole path segment, so a bare `:**` never matched any real repo path.
[includeIf "hasconfig:remote.*.url:git@gitlab.com:*/**"]
    path = ~/.gitconfig-gitlab.com
[includeIf "hasconfig:remote.*.url:https://gitlab.com/**"]
    path = ~/.gitconfig-gitlab.com

# Machine-only git config from the gitignored local/ folder in the repo (see
# the README's "Local, uncommitted tweaks"). Git skips a missing include.
# Last, so it overrides everything above.
[include]
    path = {{ .chezmoi.workingTree }}/local/gitconfig
